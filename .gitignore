# Build outputs and temporary files
*.o
/src/dwl/dwl
/src/dwlb/dwlb
/src/everbar/everbar
/src/everbar/test-status
/src/everbar/test-services
supervise/
*.log
*~
*.swp

# Generated Wayland protocol code
/src/dwl/*-protocol.h
/src/dwl/*-protocol.c
/src/dwlb/*-protocol.h
/src/dwlb/*-protocol.c

# Python/editor leftovers
__pycache__/
*.py[cod]
*.swo
.DS_Store

# Review bundles
/*-review.txt

# Host-specific secrets/history must never be published with the dotfiles.
/.ssh/
/.gnupg/
/.cert/
/.gitconfig
/.gitconfig-*
/.bash_history*
/.python_history
/.env
